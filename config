custom-shader = ./shaders/cursor_warp.glsl
custom-shader-animation = true
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Background transparency and blur
background-opacity = 0.85
background-opacity-cells = true
background-blur-radius = 20
macos-titlebar-style = transparent

font-family = "Berkeley Mono Variable"
# Fallback for icons / missing glyphs (Nerd Font)
font-family = "Cascadia Code NF"
font-size = 14

# Retina ExtraCondensed. Retina sits between SemiLight (350) and Regular (400);
# ExtraCondensed is wdth=70. Bold keeps the condensed width at bold weight.
font-variation = wght=375
font-variation = wdth=70
font-variation-italic = wght=375
font-variation-italic = wdth=70
font-variation-bold = wdth=70
font-variation-bold-italic = wdth=70

# Catppuccin theme (auto-switches with system appearance)
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Quick terminal (scratchpad)
keybind = global:ctrl+shift+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
